---
import Base from '../../layouts/Base.astro';
import MediaFrame from '../../components/media/MediaFrame.astro';
import Gallery from '../../components/media/Gallery.astro';
import { projects, projectNumber, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const i = projects.indexOf(p);
const next = projects[(i + 1) % projects.length];
const total = String(projects.length).padStart(2, '0');

const blocks = [
  { id: 'contexto', label: 'Contexto', text: p.context },
  { id: 'objetivo', label: 'Objetivo', text: p.objective },
].filter((b): b is { id: string; label: string; text: string } => Boolean(b.text));
---

<Base title={`${p.brand} — ${p.title}`} description={`${p.brand}: ${p.summary}`} theme="paper" current="projeto">
  <article class="case" data-theme="paper" aria-labelledby="case-h">
    <header class="wrap grid case-head">
      <div class="margin-col case-margin">
        <a class="back micro" href="/#trabalhos">
          <span class="arrow arrow--back" aria-hidden="true">←</span> Índice
        </a>
        <p class="micro muted case-count">Projeto {projectNumber(p)} / {total}</p>
      </div>
      <div class="body-col case-title">
        <p class="case-brand serif">{p.brand}</p>
        <h1 id="case-h" class="case-h">{p.title}</h1>
        <ul class="case-disc micro" aria-label="Disciplinas">
          {p.disciplines.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </header>

    <div class="wrap case-cover">
      <MediaFrame media={p.cover} swatch={p.swatch} label={p.brand} eager vtName={`media-${p.slug}`} />
    </div>

    <div class="wrap case-body">
      <div class="grid case-row" data-reveal>
        <p class="margin-col micro muted">Resumo</p>
        <p class="body-col lead case-summary">{p.summary}</p>
      </div>

      {
        blocks.map((b) => (
          <div class="grid case-row" data-reveal>
            <h2 class="margin-col micro muted" id={b.id}>
              {b.label}
            </h2>
            <p class="body-col prose">
              {b.text}
            </p>
          </div>
        ))
      }

      <div class="grid case-row" data-reveal>
        <h2 class="margin-col micro muted" id="contribuicao">Contribuição</h2>
        <ul class="body-col case-contrib">
          {p.contribution.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>

    <Gallery modules={p.gallery} swatch={p.swatch} label={p.brand} />

    <nav class="wrap case-next" aria-label="Próximo projeto">
      <a class="grid next-link" href={`/projetos/${next.slug}`}>
        <span class="margin-col micro muted">Próximo projeto</span>
        <span class="body-col next-body">
          <span class="next-brand serif">{next.brand}</span>
          <span class="next-title">
            {next.title} <span class="arrow" aria-hidden="true">→</span>
          </span>
        </span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .case {
    padding-bottom: var(--s-5);
  }

  .case-head {
    padding-block: var(--s-5) var(--s-4);
    row-gap: var(--s-4);
  }

  .case-margin {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
  }

  @media (min-width: 900px) {
    .case-margin {
      flex-direction: column;
      justify-content: flex-start;
      gap: var(--s-2);
      padding-top: 0.6rem;
    }
  }

  .back {
    padding-block: 0.6rem;
    margin-block: -0.6rem;
  }

  .back:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .case-brand {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.75rem);
    line-height: 1;
    margin-bottom: 0.15em;
  }

  .case-h {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 1rem + 5.4vw, 7rem);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: var(--track-display);
    font-synthesis: none;
    text-wrap: balance;
    hyphens: manual;
    max-width: 13ch;
  }

  .case-disc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--s-3);
  }

  .case-disc li {
    padding: 0.3rem 0.6rem 0.25rem;
    border: var(--line) solid var(--rule);
  }

  @media (prefers-reduced-motion: no-preference) {
    .case-title > * {
      animation: case-up var(--dur-3) var(--ease-out) both;
    }

    .case-title > :nth-child(2) {
      animation-delay: 60ms;
    }

    .case-title > :nth-child(3) {
      animation-delay: 120ms;
    }
  }

  @keyframes case-up {
    from {
      opacity: 0;
      transform: translateY(var(--rise));
    }
  }

  .case-body {
    padding-top: var(--s-5);
  }

  .case-row {
    padding-block: var(--s-3);
    border-top: var(--line) solid var(--rule);
    row-gap: 0.6rem;
    align-items: baseline;
  }

  .case-row h2,
  .case-row > p.margin-col {
    font-size: var(--fs-micro);
    font-weight: 500;
  }

  .case-summary {
    max-width: 22em;
  }

  .case-contrib {
    max-width: var(--measure);
    display: grid;
    gap: 0.6rem;
  }

  .case-contrib li {
    position: relative;
    padding-left: 1.4em;
  }

  .case-contrib li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.75em;
    height: 0.3em;
    background: var(--c-lime);
    outline: var(--line) solid var(--c-graphite);
  }

  .case-next {
    margin-top: var(--s-6);
  }

  .next-link {
    padding-block: var(--s-3) var(--s-2);
    border-top: var(--line) solid var(--fg);
    row-gap: var(--s-2);
  }

  .next-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .next-brand {
    font-size: clamp(1.25rem, 1rem + 1vw, 2rem);
    line-height: 1.1;
  }

  .next-title {
    font-family: var(--f-display);
    font-size: var(--fs-h2);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: var(--track-display);
    font-synthesis: none;
    text-wrap: balance;
  }

  .next-link:hover .next-title {
    background: linear-gradient(var(--c-lime), var(--c-lime)) 0 88% / 100% 0.32em no-repeat;
  }
</style>
