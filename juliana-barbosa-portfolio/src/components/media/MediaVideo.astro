---
import type { VideoMedia, Swatch } from '../../data/projects';
import { hasSrc } from '../../data/projects';
import MediaFrame from './MediaFrame.astro';
interface Props { media: VideoMedia; swatch: Swatch; label: string; }
const { media, swatch, label } = Astro.props;
const narrow = media.ratio === '9/16' || media.ratio === '4/5' || media.ratio === '2/3';
---
{hasSrc(media) && (
  <figure class:list={['m-video', { narrow }]} data-reveal>
    <MediaFrame media={media} swatch={swatch} label={label} />
    {media.caption && <figcaption class="micro muted">{media.caption}</figcaption>}
  </figure>
)}
<style>
  .m-video { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .m-video { grid-column: 4 / -1; }
    .m-video.narrow { grid-column: 6 / span 4; }
  }
  figcaption { margin-top: 0.6rem; }
</style>
