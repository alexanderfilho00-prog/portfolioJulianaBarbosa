---
import type { Media, Swatch } from '../../data/projects';
import { hasSrc } from '../../data/projects';
import MediaFrame from './MediaFrame.astro';
interface Props { media: [Media, Media]; swatch: Swatch; label: string; }
const { media, swatch, label } = Astro.props;
---
{media.every(hasSrc) && (
  <div class="m-pair">
    {media.map((m, i) => (
      <figure data-reveal style={`--reveal-delay:${i * 80}ms`}>
        <MediaFrame media={m} swatch={swatch} label={label} />
        {m.caption && <figcaption class="micro muted">{m.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}
<style>
  .m-pair { grid-column: 1 / -1; display: grid; gap: var(--col-gap); row-gap: var(--s-3); }
  @media (min-width: 720px) {
    .m-pair { grid-template-columns: 1fr 1fr; align-items: start; }
    .m-pair figure:nth-child(2) { margin-top: var(--s-5); }
  }
  figcaption { margin-top: 0.6rem; }
</style>
